# Nusa - Demonstrasi Fitur Bahasa
# ================================

# -- Variabel dan Tipe Data --
buat nama = "Budi"
buat umur = 25
buat tinggi = 175.5
buat sudahMenikah = salah

# -- Output --
tulis "=== NUSA PROGRAMMING LANGUAGE ==="
tulis "Nama: " + nama
tulis "Umur: " + umur
tulis "Tinggi: " + tinggi
tulis "Tipe umur: " + tipe(umur)

# -- Aritmatika --
buat a = 10
buat b = 3
tulis "10 + 3 = " + (a + b)
tulis "10 - 3 = " + (a - b)
tulis "10 * 3 = " + (a * b)
tulis "10 / 3 = " + (a / b)
tulis "10 % 3 = " + (a % b)
tulis "2 ^ 10 = " + pangkat(2, 10)

# -- Penugasan Gabungan --
buat skor = 100
skor += 50
skor -= 25
skor *= 2
tulis "Skor akhir: " + skor

# -- Perbandingan --
jika a > b {
    tulis "a lebih besar dari b"
}
kalau_tidak {
    tulis "a tidak lebih besar dari b"
}

jika a == 10 dan b == 3 {
    tulis "a dan b sesuai dugaan"
}

# -- Boolean Expression --
jika sudahMenikah == salah {
    tulis nama + " belum menikah"
}

# -- Logical Operators --
buat x = 7
jika x > 5 dan x < 10 {
    tulis "x di antara 5 dan 10"
}

jika x < 5 atau x > 6 {
    tulis "x < 5 atau x > 6"
}

jika tidak (x == 0) {
    tulis "x bukan nol"
}

# -- Percabangan Bertingkat --
buat nilai = 85

jika nilai >= 90 {
    tulis "Nilai: A"
}
kalau_tidak jika nilai >= 80 {
    tulis "Nilai: B"
}
kalau_tidak jika nilai >= 70 {
    tulis "Nilai: C"
}
kalau_tidak {
    tulis "Nilai: D"
}

# -- Pernyataan pilih --
tulis ""
tulis "=== PILIH ==="
buat pilihan = 2
pilih pilihan {
    kasus 1 { tulis "Pilihan satu" }
    kasus 2 { tulis "Pilihan dua" }
    bawaan { tulis "Pilihan lain" }
}

# -- Loop dengan ulang --
tulis ""
tulis "Menghitung 1-5:"
ulang 5 {
    tulis "Halo dari ulang"
}

# -- Loop dengan untuk --
tulis ""
tulis "Iterasi dengan nomor:"
untuk i dari 1 sampai 5 {
    tulis "Iterasi ke-" + i
}

tulis ""
tulis "Hitung mundur langkah 2:"
untuk i dari 10 sampai 2 langkah -2 {
    tulis "Mundur ke-" + i
}

# -- Loop dengan selama --
tulis ""
tulis "While loop:"
buat counter = 0
selama counter < 3 {
    tulis "Counter: " + counter
    counter += 1
}

# -- Daftar --
tulis ""
tulis "=== DAFTAR ==="
buat buah = ["apel", "jeruk", "mangga"]
tulis "Buah: " + buah
tulis "Jumlah: " + panjang(buah)
buah[1] = "pisang"
tulis "Setelah diubah: " + buah

untuk b dalam buah {
    tulis "- " + b
}

tulis "Diurutkan: " + urutkan([3, 1, 2])

# -- Fungsi --
tulis ""
tulis "=== FUNGSI ==="

fungsi sapa(nama) {
    tulis "Halo, " + nama + "!"
}

fungsi tambah(a, b) {
    kembali a + b
}

fungsi isGenap(n) {
    kembali n % 2 == 0
}

panggil sapa("Nusa")
sapa("Dunia")

buat hasil = tambah(10, 20)
tulis "10 + 20 = " + hasil
tulis "tambah(1, tambah(2, 3)) = " + tambah(1, tambah(2, 3))

jika isGenap(8) {
    tulis "8 adalah bilangan genap"
}

# -- String Concatenation --
tulis ""
tulis "Halo, nama saya " + nama + " dan umur saya " + umur + " tahun."
tulis "Nama besar: " + huruf_besar(nama)

# -- Komentar --
tulis ""
tulis "Program selesai!"
